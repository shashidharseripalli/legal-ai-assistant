# Groq API (get key at console.groq.com)
GROQ_API_KEY=gsk_your_actual_key_here
GROQ_MODEL=llama-3.1-8b-instant

# Embeddings: use the installed Ollama model if available; otherwise fall back to this free Hugging Face model
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ChromaDB
CHROMA_PERSIST_DIR=vectorstore
CHROMA_COLLECTION_NAME=legal_docs
CHROMA_UPLOAD_COLLECTION_NAME=legal_uploads

# Retrieval
RETRIEVER_K=5
RETRIEVER_FETCH_K=20
UPLOAD_RETRIEVER_K=8
UPLOAD_RETRIEVER_FETCH_K=30

# Uploads
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=15

# Streamlit frontend
# Local run:  http://localhost:8000
# Docker frontend service uses http://backend:8000
BACKEND_BASE_URL=http://localhost:8000
